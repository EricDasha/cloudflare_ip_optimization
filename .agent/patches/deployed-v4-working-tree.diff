+// sameCFnatArgs 逐字比较两组 cfnat 命令行参数。用于判定「这次换池是否需要重启」。
+// 顺序敏感：args() 的输出顺序固定，不做集合比较。
+func sameCFnatArgs(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
