+// 却没人转发。参数有任何差异（哪怕只是顺序）也一律重启，宁可多断一次，
+// 不可让配置与实跑不一致。
+func shouldSkipCFnatRestart(st processStatus, want []string) bool {
+	return st.Running && sameCFnatArgs(st.Args, want)
