# Copy to .env and fill in the real EdgeTunnel values. The .env file is ignored by Git.
PROXY_AUTO_HOST=your-worker.example.com
PROXY_AUTO_PATH=/your-websocket-path
# Optional comma/space-separated public IPv4 fallback candidates.
PROXY_USER_CANDIDATES=
# Optional preferred-domain direct-forward targets (e.g. youxuan.cf.090227.xyz,www.visa.cn).
# When empty and PROXY_AUTO_DOMAINS=true, domains discovered from cf.090227.xyz are used.
PROXY_DOMAIN_FORWARD=
# Set true to auto-append discovered preferred domains to the CFnat forward pool.
PROXY_AUTO_DOMAINS=true
# Preferred domains: resolve-supply (C-zone) + fallback. Kept for compat.
PROXY_PREFERRED_MAX_DOMAINS=20
# C-zone: resolve enabled preferred domains into candidate IPs each refresh.
PROXY_PREFERRED_RESOLVE=true
PROXY_PREFERRED_IPS_PER_DOMAIN=4
PROXY_PREFERRED_RESOLVED_CANDIDATES=64
# CFdata is manual-only now; background vars below are deprecated and unread.
PROXY_CFDATA_BACKGROUND_ENABLED=false
PROXY_CFDATA_BACKGROUND_MINUTES=60
PROXY_CFDATA_BACKGROUND_TIMEOUT=600
PROXY_CFDATA_SIFT_COUNT=40
# Daily subscription feed: converter base (token injected, never committed).
PROXY_SUBSCRIPTION_CONVERTER=https://vlesdy.trojanjd.dpdns.org/sub
PROXY_SUBSCRIPTION_MAINTAINERS=owo.o00o.ooo,cm.soso.edu.kg,zrf.zrf.me,sub.keaeye.icu,sub.mot.cloudns.biz,sub.mia.xx.kg,sub.lzjbaby.com,sub.xdu.qzz.io
PROXY_SUBSCRIPTION_TOKEN=
PROXY_SUBSCRIPTION_REFRESH_ENABLED=true
PROXY_SUBSCRIPTION_REFRESH_MINUTES=360
PROXY_SUBSCRIPTION_PER_MAINTAINER=30
PROXY_SUBSCRIPTION_FETCH_TIMEOUT=45
PROXY_SUBSCRIPTION_VERIFY_TIMEOUT=240
# Pool-switch anti-flapping: global cooldown + active health window.
PROXY_POOL_SWITCH_COOLDOWN_MINUTES=30
PROXY_ACTIVE_HEALTH_WINDOW_MINUTES=60
