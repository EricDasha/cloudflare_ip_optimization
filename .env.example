# Copy to .env and fill in the real EdgeTunnel values. The .env file is ignored by Git.
PROXY_AUTO_HOST=your-worker.example.com
PROXY_AUTO_PATH=/your-websocket-path
# Optional comma/space-separated public IPv4 fallback candidates.
PROXY_USER_CANDIDATES=
# Optional preferred-domain direct-forward targets (e.g. youxuan.cf.090227.xyz,www.visa.cn).
# When empty and PROXY_AUTO_DOMAINS=true, domains discovered from cf.090227.xyz are used.
PROXY_DOMAIN_FORWARD=
# Set true to auto-append discovered preferred domains to the CFnat forward pool.
PROXY_AUTO_DOMAINS=false
